# ============================================================
#   PJTech Autonomous Solopreneur Ecosystem - Environment Variables
#   Copy this file to .env and fill in your credentials.
# ============================================================

# --- 🎬 DIVISI MARKETING: VIDEO ENGINE ---
# Google Gemini API (AI Scriptwriting & Copywriting)
# Get your key from: https://aistudio.google.com/app/apikey
# Tips Nuyul Kuota: Masukkan banyak key dipisah koma untuk auto-failover & round-robin rotasi!
GEMINI_API_KEY=AIzaSyA...
GEMINI_API_KEYS=AIzaSyA...,AIzaSyB...,AIzaSyC...

# Pexels API (Vertical B-Roll Background Videos)
# Get your key from: https://www.pexels.com/api/
PEXELS_API_KEY=YOUR_PEXELS_API_KEY_HERE

# Deepgram API (Nova-2 Word-Level Timestamp Synchronization)
# Get your key from: https://console.deepgram.com/
DEEPGRAM_API_KEY=YOUR_DEEPGRAM_API_KEY_HERE

# Playwright E2E Kasir UMKM Credentials (Format 1 Demo App)
PLAYWRIGHT_EMAIL=pranajayatech+clerk_test@gmail.com
PLAYWRIGHT_PASSWORD=YourPassword123!
KASIR_URL=http://localhost:3000

# YouTube Data API v3 & Shorts Auto-Uploader (Google Cloud Console OAuth2)
# Buat OAuth 2.0 Client ID (Web Application atau Desktop App) di Google Cloud Console
YOUTUBE_CLIENT_ID=your_oauth_client_id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your_oauth_client_secret
YOUTUBE_REDIRECT_URI=http://localhost:3000/oauth2callback
# Opsional: Jika ingin langsung inject refresh token tanpa file tokens.json
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_PRIVACY_STATUS=public

# --- 🎛️ TELEGRAM MASTER COMMAND CENTER ---
# Bot token dari @BotFather di Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather

# ID Grup Telegram PJTech / Whitelist Channel (Contoh: -100xxxxxxxxxx)
TELEGRAM_GROUP_ID=-100xxxxxxxxxx

# ID Akun Pribadi Telegram Admin / Owner (Opsional untuk private chat command)
TELEGRAM_ADMIN_CHAT_ID=your_telegram_user_id
TELEGRAM_OWNER_CHAT_ID=your_telegram_user_id

# ID Akun Pribadi Telegram Kakak Cewe (Jalur Khusus Auto-Editor Video Affiliate)
TELEGRAM_SISTER_CHAT_ID=your_sister_telegram_user_id

# --- 🎯 DIVISI SALES: ONE SALES MAN (SIBLING PROJECT CONFIG) ---
# Lokasi: D:\Coding\one-sales-man\.env
# Catatan: Variabel di bawah ini dikonfigurasi di file .env milik folder one-sales-man

# Neon Serverless PostgreSQL Database URL (dengan pooler)
DATABASE_URL=postgresql://user:password@ep-sample-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Neon PostgreSQL Direct URL (untuk migrasi Prisma)
DIRECT_URL=postgresql://user:password@ep-sample.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Groq API Key (AI Sales Negotiator - Llama 3 70B)
# Get your key from: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
LLM_API_KEY=gsk_your_groq_api_key_here

# --- 💰 DIVISI FINANCE: MAYAR.ID PAYMENT GATEWAY ---
# Get your API key from: https://web.mayar.id/api-keys
MAYAR_API_KEY=your_mayar_api_key_here

